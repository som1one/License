# cKey API Gateway - Environment Variables

# Server Configuration
HOST=0.0.0.0
PORT=8000

# API Configuration
API_WORKERS=4
API_TIMEOUT=60
API_MAX_CONNECTIONS=1000

# CORS
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_URIS=/api/
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_REQUEST=5

# Rate limiting bucket size
API_RATE_LIMIT_BUCKET=500
API_RATE_LIMIT_BURST=10

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# SSL/HTTPS
SSL_CERTIFICATES_PATH=/etc/nginx/ssl
SSL_PRIVATE_KEY_PATH=/etc/nginx/ssl/privkey.pem
SSL_CERTIFICATE_PATH=/etc/nginx/ssl/fullchain.pem

# API Key Authentication
API_KEY_REQUIRED=false
API_KEYS=your_original_ckeY_API_KEY

# Proxy Settings
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# Database (PostgreSQL example)
DB_TYPE=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ckey_api
DB_USER=ckey_user
DB_PASSWORD=your_secure_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Redis (for caching if needed)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MAX_CONNECTIONS=50

# Cache Configuration
CACHE_ENABLED=true
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=ckey_api_

# Download Rate Limit for xk/key
DOWNLOAD_RATE_LIMIT=3

# Download connections
MAX_DOWNLOAD_CONNECTIONS=5
DOWNLOADER_TIMEOUT=60

# Special endpoint protection
CAPTCHA_REQUIRED=false
CAPTCHA_SECRET=your_google_recaptcha_secret

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=/opt/ckey-api/backups
BACKUP_COMPRESS=true

# Monitoring & Alerts
SENTRY_DSN=
PROMETHEUS_ENABLED=false
METRICS_INTERVAL=60
METRICS_PORT=9090

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/api/status
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_INTERVAL=30

# Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=ckey-api@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
NOTIFICATION_ENABLED=false

# CDN (for static files)
CDN_ENABLED=false
CDN_URL=https://your-cdn.com
STATIC_ORIGINS=https://yourdomain.com

# Rate Limit Headers
RATE_LIMIT_HEADERS_ENABLED=true
RATE_LIMIT_HEADERS_CONFIG=Any

# Logging configuration
LOGGING_FORMAT=
LOGGING_FORMAT_UNSUPPORTED=
LOGGING_TMIESTAMP=
LOGGING_NAME=
LOGGING_LEVEL=
LOGGING_STREAM=
LOGGING_FILENAME=
LOGGING_MAXBYTES=
LOGGING_BACKUPCOUNT=
LOGGING_COMPRESS=
LOGGING_DELAY=
LOGGING_FORCE=
LOGGING_DISKUSAGE_LOGLEVEL=

# Log Rotation
LOG_ROTATION_ENABLED=true
LOG_ROTATION_INTERVAL=86400